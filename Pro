local function getColor(plr)
	local hum = plr.Character and plr.Character:FindFirstChild("Humanoid")
	local hp = hum and hum.Health or 100

	-- Priority 1: Rainbow
	if Settings.ESP_RBW then
		return Color3.fromHSV((tick() % 5) / 5, 1, 1)
	end

	-- Priority 2: Team Filter
	if Settings.ESP_TM and plr.Team then
		return plr.TeamColor.Color
	end

	-- Priority 3: Custom Color
	if Settings.ESP_CLR then
		return Settings.ESP_CLR_VAL
	end

	-- Priority 4: HP Logic (Fill only handled separately)
	return Color3.fromRGB(255, 255, 255)
end

local function getFillColor(plr)
	local hum = plr.Character and plr.Character:FindFirstChild("Humanoid")
	local hp = hum and hum.Health or 100

	if Settings.ESP_TM then
		return plr.TeamColor.Color
	end

	if hp > 70 then
		return Color3.fromRGB(0, 255, 0) -- Green
	elseif hp > 30 then
		return Color3.fromRGB(255, 255, 0) -- Yellow
	elseif hp > 0 then
		return Color3.fromRGB(255, 0, 0) -- Red
	else
		return Color3.fromRGB(0, 0, 0) -- Black
	end
end

local function createESP(plr)
	if plr == LocalPlayer then return end
	if espObjects[plr] then return end -- No duplicate

	local char = plr.Character
	if not char then
		dbg("No character for " .. plr.Name)
		return
	end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChild("Humanoid")
	if not hrp or not hum then
		dbg("No HRP/Humanoid for " .. plr.Name)
		return
	end

	dbg("Creating ESP for " .. plr.Name)

	-- Highlight
	local hl = Instance.new("Highlight")
	hl.Adornee = char
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillColor = getFillColor(plr)
	hl.OutlineColor = getColor(plr)
	hl.FillTransparency = Settings.ESP_FIL and 0.5 or 1
	hl.OutlineTransparency = 0
	hl.Enabled = Settings.ESP_HL
	hl.Parent = char

	-- Billboard Gui
	local bg = Instance.new("BillboardGui")
	bg.Name = "ESP_Billboard"
	bg.AlwaysOnTop = true
	bg.Size = UDim2.new(0, 200, 0, 50)
	bg.StudsOffset = Vector3.new(0, 3, 0)
	bg.MaxDistance = 500
	bg.Parent = hrp

	local txtLabel = Instance.new("TextLabel")
	txtLabel.Name = "ESP_Label"
	txtLabel.Size = UDim2.new(1, 0, 1, 0)
	txtLabel.BackgroundTransparency = 1
	txtLabel.TextColor3 = Settings.ESP_RBW and Color3.fromHSV((tick() % 5) / 5, 1, 1) or Color3.fromRGB(255, 255, 255)
	txtLabel.TextStrokeTransparency = 0.5
	txtLabel.TextSize = 12
	txtLabel.Font = Enum.Font.GothamSemibold
	txtLabel.Parent = bg

	espObjects[plr] = {hl = hl, bg = bg, plr = plr}

	-- Ancestry listener for cleanup
	local ancConn = char.AncestryChanged:Connect(function(_, parent)
		if not parent then
			dbg("Character removed for " .. plr.Name)
			removeESP(plr)
		end
	end)

	if not activeConnections[plr] then
		activeConnections[plr] = {}
	end
	table.insert(activeConnections[plr], ancConn)
end

local function removeESP(plr)
	local data = espObjects[plr]
	if not data then return end

	dbg("Removing ESP for " .. plr.Name)

	if data.hl then
		data.hl:Destroy()
	end
	if data.bg then
		data.bg:Destroy()
	end

	-- Clean connections
	if activeConnections[plr] then
		for _, conn in ipairs(activeConnections[plr]) do
			conn:Disconnect()
		end
		activeConnections[plr] = nil
	end

	espObjects[plr] = nil
end

local function updateESP(plr)
	local data = espObjects[plr]
	if not data then return end

	local hl = data.hl
	local bg = data.bg

	if hl and hl.Parent then
		hl.Enabled = Settings.ESP_HL
		hl.FillColor = getFillColor(plr)
		hl.OutlineColor = getColor(plr)
		hl.FillTransparency = Settings.ESP_FIL and 0.5 or 1
		hl.OutlineTransparency = 0
	end

	if bg and bg.Parent then
		local char = plr.Character
		local hum = char and char:FindFirstChild("Humanoid")
		local txtLabel = bg:FindFirstChild("ESP_Label")
		if txtLabel then
			local textParts = {}
			if Settings.ESP_NM then
				table.insert(textParts, plr.Name)
			end
			if Settings.ESP_DST then
				local localChar = LocalPlayer.Character
				local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
				local targetHRP = char and char:FindFirstChild("HumanoidRootPart")
				if localHRP and targetHRP then
					local dist = math.floor((localHRP.Position - targetHRP.Position).Magnitude)
					table.insert(textParts, dist .. " studs")
				end
			end
			if Settings.ESP_HP and hum then
				table.insert(textParts, "HP: " .. math.floor(hum.Health))
			end
			txtLabel.Text = table.concat(textParts, "\n")
		end
	end
end

function refreshAllESP()
	for plr, _ in pairs(espObjects) do
		updateESP(plr)
	end
end


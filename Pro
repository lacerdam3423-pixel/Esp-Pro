local function CreateInstance(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        if k == "Children" then
            for _, child in ipairs(v) do
                child.Parent = inst
            end
        else
            inst[k] = v
        end
    end
    return inst
end


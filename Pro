-- ====================== DRAG SYSTEM ======================
local function enableDrag()
	local dragging = false
	local dragStart = Vector2.new()
	local startPos = UDim2.new()

	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = mainFrame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
end
enableDrag()

-- ====================== ESP LOGIC ======================
local playerData = {}

local function getHighlightColor(player, character)
	if rainbowEnabled then
		local hue = (tick() * 1.5) % 1
		return Color3.fromHSV(hue, 1, 1)
	end
	if customColorEnabled then
		return customColor
	end
	if timeFilterEnabled then
		local team = player.Team
		local baseColor = team and team.TeamColor.Color or Color3.new(1, 1, 1)
		local health = character and character:FindFirstChild("Humanoid") and character.Humanoid.Health or 100
		if health <= 0 then
			return Color3.new(0, 0, 0)
		end
		return baseColor
	end
	-- Health based
	local health = character and character:FindFirstChild("Humanoid") and character.Humanoid.Health or 100
	if health <= 0 then return Color3.new(0, 0, 0)
	elseif health < 25 then return Color3.new(1, 0, 0)
	elseif health < 75 then return Color3.new(1, 1, 0)
	else return Color3.new(0, 1, 0)
	end
end

local function updateESP(player, character)
	local data = playerData[player]
	if not data or data.character ~= character then return end
	if not espEnabled then
		if data.highlight then data.highlight.Enabled = false end
		if data.billboard then data.billboard.Enabled = false end
		return
	end
	if data.highlight then
		data.highlight.Enabled = true
		data.highlight.FillColor = getHighlightColor(player, character)
		data.highlight.OutlineColor = getHighlightColor(player, character)
	end
	if data.billboard then
		data.billboard.Enabled = true
		-- Name
		if data.nameLabel then
			data.nameLabel.Visible = nameEnabled
			if nameEnabled then
				data.nameLabel.Text = player.Name
			end
		end
		-- Distance
		if data.distanceLabel then
			data.distanceLabel.Visible = distanceEnabled
			if distanceEnabled and character:FindFirstChild("HumanoidRootPart") and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local dist = (character.HumanoidRootPart.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude
				data.distanceLabel.Text = string.format("%.0f studs", dist)
			end
		end
		-- Health
		if data.healthLabel then
			data.healthLabel.Visible = healthTextEnabled
			if healthTextEnabled then
				local humanoid = character:FindFirstChild("Humanoid")
				local hp = humanoid and humanoid.Health or 0
				data.healthLabel.Text = "HP: " .. math.floor(hp)
			end
		end
	end
end

local function setupCharacter(player, character)
	-- Clean up old
	local old = playerData[player]
	if old then
		if old.highlight then old.highlight:Destroy() end
		if old.billboard then old.billboard:Destroy() end
	end
	if not character then
		playerData[player] = nil
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "MigueleHighlight"
	highlight.FillTransparency = 0.4
	highlight.OutlineTransparency = 0
	highlight.Enabled = true
	highlight.Parent = character

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "MigueleInfo"
	billboard.Size = UDim2.new(0, 200, 0, 60)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character
	billboard.Parent = character

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = billboard

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Name"
	nameLabel.Size = UDim2.new(1, 0, 0, 18)
	nameLabel.BackgroundTransparency = 1
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.Font = Enum.Font.GothamSemibold
	nameLabel.TextSize = 14
	nameLabel.TextStrokeTransparency = 0.6
	nameLabel.LayoutOrder = 1
	nameLabel.Parent = billboard

	local distanceLabel = nameLabel:Clone()
	distanceLabel.Name = "Distance"
	distanceLabel.LayoutOrder = 2
	distanceLabel.Parent = billboard

	local healthLabel = nameLabel:Clone()
	healthLabel.Name = "Health"
	healthLabel.LayoutOrder = 3
	healthLabel.Parent = billboard

	playerData[player] = {
		character = character,
		highlight = highlight,
		billboard = billboard,
		nameLabel = nameLabel,
		distanceLabel = distanceLabel,
		healthLabel = healthLabel
	}
	updateESP(player, character)
end

-- Connect player events
local function onPlayerAdded(player)
	if player == localPlayer then return end
	local function charAdded(char)
		setupCharacter(player, char)
	end
	if player.Character then
		charAdded(player.Character)
	end
	player.CharacterAdded:Connect(charAdded)
end

for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	local data = playerData[player]
	if data then
		if data.highlight then data.highlight:Destroy() end
		if data.billboard then data.billboard:Destroy() end
		playerData[player] = nil
	end
end)

-- Continuous ESP update loop
spawn(function()
	while true do
		for player, data in pairs(playerData) do
			if data.character and data.character.Parent then
				updateESP(player, data.character)
			end
		end
		RunService.Heartbeat:Wait() -- smoother updates
	end
end)

-- Final language application
applyLanguage(currentLang)

-- Build ESP Tab
local function BuildESP()
    local yOffset = 10
    local toggles = {}

    local masterToggle = CreateToggle(ESPContent, GetText("MASTER"), Settings.ESP, function(state)
        Settings.ESP = state
        for _, t in pairs(toggles) do
            if t ~= masterToggle then
                t.SetState(state)
            end
        end
    end)
    masterToggle.Button.Position = UDim2.new(0, 5, 0, yOffset)
    yOffset += 32

    local toggleNames = {"HL", "NM", "DST", "HP", "TMF", "RBW", "FILL"}
    for _, name in ipairs(toggleNames) do
        local toggle = CreateToggle(ESPContent, GetText(name), Settings[name], function(state)
            Settings[name] = state
        end)
        toggle.Button.Position = UDim2.new(0, 5, 0, yOffset)
        toggles[name] = toggle
        yOffset += 32
    end

    local clrBtn = CreateInstance("TextButton", {
        Parent = ESPContent,
        Size = UDim2.new(1, -10, 0, 28),
        Position = UDim2.new(0, 5, 0, yOffset),
        BackgroundColor3 = Color3.fromRGB(50, 50, 60),
        Text = GetText("COLOR_PICKER"),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        BorderSizePixel = 0
    })
    CreateInstance("UICorner", { Parent = clrBtn, CornerRadius = UDim.new(0, 6) })
    CreateInstance("UIStroke", {
        Parent = clrBtn,
        Thickness = 1,
        Color = Color3.fromRGB(0, 255, 255),
        Transparency = 0.5
    })
    yOffset += 32

    ColorPickerFrame = CreateColorPicker(ESPContent)
    ColorPickerFrame.Position = UDim2.new(0, 5, 0, yOffset)

    clrBtn.MouseButton1Click:Connect(function()
        ColorPickerOpen = not ColorPickerOpen
        if ColorPickerOpen then
            ColorPickerFrame:TweenSize(UDim2.new(1, -10, 0, 120), "Out", "Quad", 0.3)
        else
            ColorPickerFrame:TweenSize(UDim2.new(1, -10, 0, 0), "Out", "Quad", 0.3)
        end
    end)

    ESPContent.CanvasSize = UDim2.new(0, 0, 0, yOffset + 10)
end


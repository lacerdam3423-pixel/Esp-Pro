-- PlayerAdded
Players.PlayerAdded:Connect(function(plr)
	dbg("Player detected: " .. plr.Name)
	local charConn
	charConn = plr.CharacterAdded:Connect(function(char)
		dbg("Character loaded: " .. plr.Name)
		removeESP(plr)
		task.wait(0.1)
		createESP(plr)
	end)
	table.insert(activeConnections, charConn)
end)

-- CharacterAdded for existing players
for _, plr in ipairs(Players:GetPlayers()) do
	if plr ~= LocalPlayer then
		local charConn = plr.CharacterAdded:Connect(function(char)
			dbg("Character loaded: " .. plr.Name)
			removeESP(plr)
			task.wait(0.1)
			createESP(plr)
		end)
		if not activeConnections[plr] then
			activeConnections[plr] = {}
		end
		table.insert(activeConnections[plr], charConn)
	end
end

-- PlayerRemoving
Players.PlayerRemoving:Connect(function(plr)
	dbg("Player left: " .. plr.Name)
	removeESP(plr)
end)


local function createToggle(name, defaultState, parent)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -20, 0, 40)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	frame.BackgroundTransparency = 0.3
	frame.BorderSizePixel = 0
	frame.Parent = parent
	
	local frameCorner = Instance.new("UICorner", frame)
	frameCorner.CornerRadius = UDim.new(0, 8)
	
	local frameStroke = Instance.new("UIStroke", frame)
	frameStroke.Color = Color3.fromRGB(0, 255, 255)
	frameStroke.Thickness = 1
	frameStroke.Transparency = 0.7
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.6, 0, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(200, 200, 200)
	label.TextSize = 14
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame
	
	local toggleButton = Instance.new("TextButton")
	toggleButton.Size = UDim2.new(0, 40, 0, 20)
	toggleButton.Position = UDim2.new(1, -50, 0.5, -10)
	toggleButton.BackgroundColor3 = defaultState and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(60, 60, 60)
	toggleButton.BorderSizePixel = 0
	toggleButton.Text = ""
	toggleButton.Font = Enum.Font.Gotham
	toggleButton.Parent = frame
	
	local toggleCorner = Instance.new("UICorner", toggleButton)
	toggleCorner.CornerRadius = UDim.new(0, 10)
	
	local toggleStroke = Instance.new("UIStroke", toggleButton)
	toggleStroke.Color = Color3.fromRGB(0, 255, 255)
	toggleStroke.Thickness = 1
	toggleStroke.Transparency = 0.5
	
	local indicator = Instance.new("Frame")
	indicator.Size = UDim2.new(0, 16, 0, 16)
	indicator.Position = defaultState and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
	indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	indicator.BorderSizePixel = 0
	indicator.Parent = toggleButton
	
	local indicatorCorner = Instance.new("UICorner", indicator)
	indicatorCorner.CornerRadius = UDim.new(0, 8)
	
	local state = defaultState
	
	local function updateVisual()
		local targetColor = state and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(60, 60, 60)
		local targetPos = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
		
		local bgTween = TweenService:Create(toggleButton, TweenInfo.new(0.2), {BackgroundColor3 = targetColor})
		bgTween:Play()
		
		local indTween = TweenService:Create(indicator, TweenInfo.new(0.2), {Position = targetPos})
		indTween:Play()
	end
	
	toggleButton.MouseButton1Click:Connect(function()
		state = not state
		updateVisual()
	end)
	
	return {
		Frame = frame,
		Toggle = toggleButton,
		GetState = function() return state end,
		SetState = function(newState)
			state = newState
			updateVisual()
		end,
		UpdateLabel = function(newText)
			label.Text = newText
		end
	}
end


-- Toggle Function
local function CreateToggle(parent, text, default, callback)
    local toggled = default
    local btn = CreateInstance("TextButton", {
        Parent = parent,
        Size = UDim2.new(1, -10, 0, 28),
        Position = UDim2.new(0, 5, 0, 0),
        BackgroundColor3 = toggled and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(50, 50, 60),
        Text = text,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        BorderSizePixel = 0
    })
    CreateInstance("UICorner", { Parent = btn, CornerRadius = UDim.new(0, 6) })
    CreateInstance("UIStroke", {
        Parent = btn,
        Thickness = 1,
        Color = Color3.fromRGB(0, 255, 255),
        Transparency = 0.5
    })

    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        btn.BackgroundColor3 = toggled and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(50, 50, 60)
        callback(toggled)
    end)

    return {
        Button = btn,
        SetState = function(state)
            toggled = state
            btn.BackgroundColor3 = toggled and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(50, 50, 60)
        end
    }
end


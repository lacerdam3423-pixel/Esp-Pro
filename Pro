local playerESP = {}

local function getHealthColor(health, maxHealth)
	if not health or not maxHealth or maxHealth == 0 then
		return Color3.fromRGB(0, 0, 0)
	end
	
	local ratio = health / maxHealth
	
	if ratio > 0.66 then
		return Color3.fromRGB(0, 255, 0)
	elseif ratio > 0.33 then
		return Color3.fromRGB(255, 255, 0)
	elseif ratio > 0 then
		return Color3.fromRGB(255, 0, 0)
	else
		return Color3.fromRGB(0, 0, 0)
	end
end

local function getTeamColor(player)
	local team = player.Team
	if team then
		return team.TeamColor.Color
	end
	return customColor
end

local function updateESPForPlayer(player)
	local data = playerESP[player]
	if not data then return end
	
	local character = player.Character
	if not character then
		if data.highlight then
			data.highlight.Enabled = false
		end
		if data.billboard then
			data.billboard.Enabled = false
		end
		return
	end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	
	if not humanoid or not rootPart then
		if data.highlight then
			data.highlight.Enabled = false
		end
		if data.billboard then
			data.billboard.Enabled = false
		end
		return
	end
	
	local highlightEnabled = highlightToggle.GetState()
	local nameEnabled = nameToggle.GetState()
	local distanceEnabled = distanceToggle.GetState()
	local healthEnabled = healthToggle.GetState()
	local teamFilterEnabled = teamFilterToggle.GetState()
	local rainbowEnabled = rainbowToggle.GetState()
	local fillEnabled = fillToggle.GetState()
	
	if data.highlight then
		data.highlight.Enabled = highlightEnabled
		data.highlight.FillTransparency = fillEnabled and 0.5 or 1
		data.highlight.OutlineTransparency = 0
		
		if teamFilterEnabled then
			data.highlight.FillColor = getTeamColor(player)
			data.highlight.OutlineColor = getTeamColor(player)
		elseif rainbowEnabled then
			data.highlight.FillColor = Color3.fromHSV(rainbowHue, 1, 1)
			data.highlight.OutlineColor = Color3.fromHSV(rainbowHue, 1, 1)
		else
			data.highlight.FillColor = customColor
			data.highlight.OutlineColor = customColor
		end
		
		if not teamFilterEnabled and fillEnabled then
			local health = humanoid.Health
			local maxHealth = humanoid.MaxHealth
			data.highlight.FillColor = getHealthColor(health, maxHealth)
		end
	end
	
	if data.billboard then
		local showBillboard = (nameEnabled or distanceEnabled or healthEnabled) and highlightEnabled
		data.billboard.Enabled = showBillboard
		
		if showBillboard then
			local nameText = nameEnabled and player.Name or ""
			local distanceText = ""
			local healthText = ""
			
			if distanceEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local dist = (rootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
				distanceText = math.floor(dist) .. " studs"
			end
			
			if healthEnabled then
				healthText = "HP: " .. math.floor(humanoid.Health)
			end
			
			local combinedText = {}
			if nameText ~= "" then table.insert(combinedText, nameText) end
			if distanceText ~= "" then table.insert(combinedText, distanceText) end
			if healthText ~= "" then table.insert(combinedText, healthText) end
			
			data.billboardText.Text = table.concat(combinedText, "\n")
		end
	end
end

local function setupPlayerESP(player)
	if player == LocalPlayer then return end
	
	local highlight = Instance.new("Highlight")
	highlight.Name = "ESP_Highlight"
	highlight.Enabled = false
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = customColor
	highlight.OutlineColor = customColor
	
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_Billboard"
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = ""
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextSize = 14
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextStrokeTransparency = 0
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.Parent = billboard
	
	playerESP[player] = {
		highlight = highlight,
		billboard = billboard,
		billboardText = textLabel
	}
	
	local function onCharacterAdded(character)
		highlight.Parent = character
		local head = character:WaitForChild("Head")
		if head then
			billboard.Parent = head
		end
	end
	
	if player.Character then
		onCharacterAdded(player.Character)
	end
	
	player.CharacterAdded:Connect(onCharacterAdded)
end

local function removePlayerESP(player)
	local data = playerESP[player]
	if data then
		if data.highlight then data.highlight:Destroy() end
		if data.billboard then data.billboard:Destroy() end
		playerESP[player] = nil
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayerESP(player)
end

Players.PlayerAdded:Connect(setupPlayerESP)
Players.PlayerRemoving:Connect(removePlayerESP)

RunService.Heartbeat:Connect(function(deltaTime)
	rainbowHue = (rainbowHue + deltaTime * 0.5) % 1
	
	for player, data in pairs(playerESP) do
		updateESPForPlayer(player)
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	if input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.LeftControl then
		if uiOpen then
			closeUI()
		else
			openUI()
		end
	end
end)

-- ====================== LANGUAGE SYSTEM ======================
local dynamicTexts = {}

local function applyLanguage(lang)
	local t = translations[lang]
	titleLabel.Text = t.title
	espTabBtn.Text = t.tabEsp
	settingsTabBtn.Text = t.tabSettings
	for _, entry in ipairs(dynamicTexts) do
		if entry.type == "label" then
			entry.object.Text = t[entry.key]
		elseif entry.type == "button" then
			if entry.key == "on" or entry.key == "off" then
				entry.object.Text = entry.state and t.on or t.off
			else
				entry.object.Text = t[entry.key]
			end
		end
	end
end

-- ====================== TOGGLE HELPER ======================
local function createToggle(parent, textKey, default, callback)
	local t = translations[currentLang]
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -20, 0, 32)
	frame.BackgroundTransparency = 1
	frame.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.6, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = t[textKey]
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.Gotham
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame
	table.insert(dynamicTexts, {object = label, type = "label", key = textKey})

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.35, 0, 0.8, 0)
	btn.Position = UDim2.new(0.65, 0, 0.1, 0)
	btn.BackgroundColor3 = default and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(100, 100, 100)
	btn.Text = default and t.on or t.off
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Parent = frame
	-- Hover effect
	btn.MouseEnter:Connect(function()
		btn.BackgroundColor3 = btn.BackgroundColor3:Lerp(Color3.new(0.5, 0.5, 0.5), 0.3)
	end)
	btn.MouseLeave:Connect(function()
		if state then
			btn.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
		else
			btn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		end
	end)

	local state = default
	btn.Activated:Connect(function()
		state = not state
		btn.BackgroundColor3 = state and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(100, 100, 100)
		btn.Text = state and t.on or t.off
		callback(state)
		local entry = nil
		for _, e in ipairs(dynamicTexts) do
			if e.object == btn then entry = e; break end
		end
		if entry then entry.state = state end
	end)
	table.insert(dynamicTexts, {object = btn, type = "button", key = "on", state = state}) -- on/off key
	return {button = btn, getState = function() return state end}
end


-- Drag Handling
local dragging = false
local dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ESP System
local function getHPColor(hp, maxhp)
    local ratio = hp / maxhp
    if ratio <= 0 then return Color3.fromRGB(0, 0, 0)
    elseif ratio < 0.3 then return Color3.fromRGB(255, 0, 0)
    elseif ratio < 0.7 then return Color3.fromRGB(255, 255, 0)
    else return Color3.fromRGB(0, 255, 0) end
end

local function getRainbowColor(time)
    local hue = (time % 5) / 5
    return Color3.fromHSV(hue, 1, 1)
end

local function getESPColor(plr)
    if Settings.TMF and plr.Team and LP.Team then
        return plr.TeamColor.Color
    elseif Settings.RBW then
        return getRainbowColor(os.clock())
    else
        return Settings.CLR
    end
end

local function createESP(plr)
    if plr == LP then return end
    if ESP_Cache[plr] then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = plr.Character
    highlight.FillTransparency = Settings.FILL and 0.5 or 1
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = plr.Character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 200, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Parent = plr.Character

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 18)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = billboard

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0, 18)
    distLabel.Position = UDim2.new(0, 0, 0, 18)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    distLabel.TextStrokeTransparency = 0
    distLabel.TextSize = 11
    distLabel.Font = Enum.Font.Gotham
    distLabel.Parent = billboard

    local hpLabel = Instance.new("TextLabel")
    hpLabel.Size = UDim2.new(1, 0, 0, 18)
    hpLabel.Position = UDim2.new(0, 0, 0, 34)
    hpLabel.BackgroundTransparency = 1
    hpLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    hpLabel.TextStrokeTransparency = 0
    hpLabel.TextSize = 11
    hpLabel.Font = Enum.Font.Gotham
    hpLabel.Parent = billboard

    ESP_Cache[plr] = {
        Highlight = highlight,
        Billboard = billboard,
        NameLabel = nameLabel,
        DistLabel = distLabel,
        HPLabel = hpLabel
    }

    local function onCharacterAdded(char)
        highlight.Adornee = char
        billboard.Parent = char
        local humanoid = char:WaitForChild("Humanoid")
        local rootPart = char:WaitForChild("HumanoidRootPart")

        local updateConnection
        updateConnection = RunService.Heartbeat:Connect(function()
            if not char or not char.Parent then
                updateConnection:Disconnect()
                return
            end

            if not Settings.ESP or not Settings.HL then
                highlight.Enabled = false
            else
                highlight.Enabled = true
                local color = getESPColor(plr)
                highlight.OutlineColor = color
                if Settings.FILL then
                    highlight.FillColor = Settings.TMF and plr.TeamColor.Color or (Settings.RBW and getRainbowColor(os.clock()) or Settings.CLR)
                    highlight.FillTransparency = 0.5
                    if Settings.HP and Settings.TMF == false and humanoid.Health > 0 then
                        highlight.FillColor = getHPColor(humanoid.Health, humanoid.MaxHealth)
                    end
                else
                    highlight.FillTransparency = 1
                end
            end

            if not Settings.ESP or not Settings.NM then
                nameLabel.Visible = false
            else
                nameLabel.Visible = true
                nameLabel.Text = plr.Name
            end

            if not Settings.ESP or not Settings.DST then
                distLabel.Visible = false
            else
                distLabel.Visible = true
                if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and rootPart then
                    local dist = (LP.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
                    distLabel.Text = math.floor(dist) .. " Studs"
                end
            end

            if not Settings.ESP or not Settings.HP then
                hpLabel.Visible = false
            else
                hpLabel.Visible = true
                hpLabel.Text = "HP: " .. math.floor(humanoid.Health)
            end
        end)
    end

    if plr.Character then
        onCharacterAdded(plr.Character)
    end

    plr.CharacterAdded:Connect(onCharacterAdded)
end

local function removeESP(plr)
    if ESP_Cache[plr] then
        local cache = ESP_Cache[plr]
        if cache.Highlight then cache.Highlight:Destroy() end
        if cache.Billboard then cache.Billboard:Destroy() end
        ESP_Cache[plr] = nil
    end
end

